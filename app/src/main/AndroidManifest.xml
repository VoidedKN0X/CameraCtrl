<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- CameraCtrl works fully offline: no INTERNET permission. Remove it (and network state) in case a library
         ever adds them; CI also checks the built APK has neither. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <!-- Photos and videos. No location permission: no photo ever carries your position. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Sound for videos only; asked for when you switch to Video, and videos record silently without it. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Fingerprint unlock for the app lock. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Hides other apps' floating windows over the lock and PIN screens only. Install-time permission, no prompt. -->
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />
    <!-- Interval shooting and timelapses: a camera-type foreground service keeps a run going while the screen is
         dimmed or off. Install-time permissions, no prompt; only used while a run you started is going. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />

    <uses-feature android:name="android.hardware.camera.any" android:required="true" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- intentMatchingFlags (Android 16+): other apps can only start CameraCtrl with an intent that matches
         its filters (the launcher, and "open the camera"). -->
    <application
        android:name=".CameraCtrlApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:enableOnBackInvokedCallback="true"
        android:intentMatchingFlags="enforceIntentFilter"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.CameraCtrl">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|density|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The camera button, a double press of the power key and other apps' "open camera". -->
            <intent-filter>
                <action android:name="android.media.action.STILL_IMAGE_CAMERA" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.media.action.VIDEO_CAMERA" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Holds an interval run (camera type). Not exported: only CameraCtrl itself can start or stop it. -->
        <service
            android:name=".interval.IntervalService"
            android:exported="false"
            android:foregroundServiceType="camera" />

        <!-- No downloadable emoji font: don't let androidx.emoji2 look one up from a font provider
             at start-up. Emoji are drawn with the phone's own emoji font instead. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                tools:node="remove" />
        </provider>
    </application>
</manifest>