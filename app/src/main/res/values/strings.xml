    <!-- Night mode -->
    <string name="mode_night">NIGHT</string>
    <string name="take_night_photo">Take a night photo (several frames merged)</string>
    <string name="night_handheld">HANDHELD · %1$d FRAMES</string>
    <string name="night_tripod">TRIPOD · %1$d FRAMES</string>
    <string name="night_note_handheld">Night mode takes %1$d photos in a row and merges them into one JPEG with less noise. It\'s a multi-frame merge, not one long exposure: hold the phone as still as you can until it\'s done. Things that move may look softer. RAW isn\'t saved in night mode.</string>
    <string name="night_note_tripod">Night mode takes %1$d longer photos in a row and merges them into one JPEG with less noise. It\'s a multi-frame merge, not one long exposure: put the phone on a tripod or something steady and don\'t touch it until it\'s done. RAW isn\'t saved in night mode.</string>
    <string name="night_capturing">HOLD STILL · FRAME %1$d OF %2$d</string>
    <string name="night_merging">MERGING %1$d FRAMES…</string>
    <string name="night_last">Last night photo: %1$d frames merged</string>

