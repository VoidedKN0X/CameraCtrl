    <string name="settings_subtitle">Photo, RAW, video and privacy</string>
    <string name="app_lock_subtitle">Ask for an app PIN (and optionally your fingerprint) when opening CameraCtrl.</string>
    <string name="app_lock_footer">CameraCtrl works fully offline: it has no internet permission, analytics or location access. Photos and videos go straight to your library on this phone.</string>
    <string name="lock_prompt_subtitle">Your camera</string>
    <string name="lock_forgot_body">The PIN can\'t be recovered. CameraCtrl will reset its settings and turn the app lock off. The photos and videos you took are in your library and aren\'t touched.</string>

