    <string name="zsl">Zero shutter lag</string>
    <string name="zsl_sub">Lets the camera save the moment you pressed, on lenses that offer it. Not used with the flash, manual exposure, bracketing or maximum resolution.</string>
    <string name="ultra_hdr">Ultra HDR photos</string>
    <string name="ultra_hdr_sub">JPEGs with an HDR gain map, brighter highlights on HDR screens, on lenses that offer it. Other screens show a normal JPEG.</string>
    <string name="closeup_switch">Switch lens for close-ups</string>
    <string name="closeup_switch_sub">When a single lens can\'t focus that close, switch to the lens that focuses closest and back again, going by each lens\'s closest focus as your phone reports it</string>

    <!-- Viewfinder aids -->
    <string name="group_viewfinder">Viewfinder</string>
    <string name="histogram">Histogram</string>
    <string name="histogram_sub">Brightness of the picture, from dark to light; a violet edge means something is pure black or pure white</string>
    <string name="peaking">Focus peaking</string>
    <string name="peaking_sub">Marks the sharpest edges in violet while you focus by hand (Pro, Focus)</string>
    <string name="level">Level</string>
    <string name="level_sub">A line that stays level with the horizon; it turns violet when the phone is straight</string>
    <string name="viewfinder_footer">The histogram and focus peaking are worked out from the viewfinder picture on the phone, a few times a second.</string>

